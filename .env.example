API_KEY=local-payment-api-key
POSTGRES_USER=payments
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_DB=payments
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=local-rabbitmq-password
API_PORT=8088
RABBITMQ_MANAGEMENT_PORT=15688
# Разрешаем webhook только на явно указанные адреса, без перенаправлений.
WEBHOOK_ALLOWED_ORIGINS=["http://host.docker.internal:8090"]
